extends Node3D

var player_spawn: Vector3:
	get:
		return %PlayerSpawn.global_position

var enemy_spawn: Vector3:
	get:
		return %EnemySpawn.global_position

var generator_spawn: Vector3:
	get:
		return %GeneratorSpawn.global_position


func rebuild(navigation_region: NavigationRegion3D) -> Array[Marker3D]:
	# Geometry and spawn markers are authored in level_map.tscn (generated by
	# tools/gen_level.py) so they remain visible and editable in Godot's 3D
	# viewport. The main controller bakes navigation one physics frame later,
	# after all CSG geometry is ready.
	if navigation_region.navigation_mesh == null:
		push_error("LevelMap requires a NavigationMesh resource")

	_place_pressure_valves()

	var markers: Array[Marker3D] = []
	for child in %GasSpawnPoints.get_children():
		if child is Marker3D:
			markers.append(child)
	return markers


func _place_pressure_valves() -> void:
	# The valves belong to the plant's pipe network: A in the steam hall, B in
	# the boiler room, C in the pump station.
	var valves := get_tree().get_nodes_in_group("pressure_valve")
	valves.sort_custom(func(a: Node, b: Node) -> bool: return a.valve_id < b.valve_id)
	var spawns := $ValveSpawns.get_children()
	for index in mini(valves.size(), spawns.size()):
		var valve := valves[index] as Node3D
		valve.global_transform = (spawns[index] as Marker3D).global_transform
